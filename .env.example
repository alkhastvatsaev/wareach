# WAREACH — Brand Protection OSINT Platform
APP_NAME=WAREACH
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mac default: SQLite. For VPS set USE_SQLITE=false and DATABASE_URL=postgres...
USE_SQLITE=true
DATABASE_URL=postgresql+psycopg2://wareach:wareach@127.0.0.1:5432/wareach

# Redis / Celery (optional on Mac; required for 24/7 workers)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Agent Reach / discovery
AGENT_REACH_BIN=agent-reach
MCPORTER_BIN=mcporter
JINA_READER_PREFIX=https://r.jina.ai/
EXA_NUM_RESULTS=10
DISCOVERY_CONCURRENCY=4
CRAWL_CONCURRENCY=6
REQUEST_TIMEOUT_SEC=45
RATE_LIMIT_PER_HOST=2.0

# Loop
CONTINUOUS_MODE=true
DISCOVERY_INTERVAL_SEC=300
CRAWL_INTERVAL_SEC=120
MAX_QUEUE_DEPTH=5000

# Brands monitored
TARGET_BRANDS=hermes,louis_vuitton,cartier,chanel,gucci,dior

# Evidence
EVIDENCE_DIR=./data/evidence
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
